# Server
# Required — the server refuses to start without it (no more silent
# fallback to postgres://localhost/solarplex).
DATABASE_URL=postgres://localhost/solarplex
BIND_ADDR=0.0.0.0:8080

# DB connection pool sizing — all optional, each defaults to sqlx's own
# default (shown below) if unset. A misconfigured value here degrades to
# the default with a warning rather than failing startup, unlike
# DATABASE_URL above — there's no "unsafe to guess" pool size the way
# there is a wrong DB target.
# DB_POOL_MAX_CONNECTIONS=20
# DB_POOL_MIN_CONNECTIONS=0
# DB_POOL_ACQUIRE_TIMEOUT_SECS=30
# DB_POOL_IDLE_TIMEOUT_SECS=600

# TLS is optional: set both to terminate TLS in this process directly, or
# leave both unset and terminate TLS at a reverse proxy instead (see
# deploy/caddy/Caddyfile for a reference config). Setting only one is
# a startup error.
# TLS_CERT_PATH=/etc/solarplex/tls/fullchain.pem
# TLS_KEY_PATH=/etc/solarplex/tls/privkey.pem

# Error tracking (optional). Points at a self-hosted GlitchTip instance
# (deploy/glitchtip/, Sentry-protocol-compatible — this is the official
# Sentry Rust SDK, not a GlitchTip-specific one). Unset or empty means
# error tracking is fully disabled; nothing touches the network. The DSN
# is generated by GlitchTip itself once a project exists in its UI — see
# deploy/glitchtip/docker-compose.yml.j2's header comment for how that
# instance gets deployed, and solarplex.service for how this value is
# delivered on a real deployment (a second, independent age-encrypted file,
# not this one).
# GLITCHTIP_DSN=http://<key>@localhost:8000/<project-id>

# Comma-separated list of origins the browser frontend is allowed to call
# this API from. Defaults to http://localhost:3000 (the local dev frontend)
# if unset — set this explicitly for anything other than local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to 1 only when this server genuinely sits behind a reverse proxy that
# overwrites (not merely forwards) the X-Forwarded-For header — otherwise a
# client could spoof it to dodge the OIDC endpoint rate limit. Leave unset
# when the server is reachable directly.
# TRUST_PROXY_HEADERS=1

# OIDC (required — the server refuses to start the sign-in flow without these).
# See README.md's "OIDC setup" section for how to register a Google OAuth
# client; any other OIDC-discovery-capable provider works too.
OIDC_ISSUER_URL=https://accounts.google.com
OIDC_CLIENT_ID=<from your OAuth provider>
OIDC_CLIENT_SECRET=<from your OAuth provider>
OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
# Where to bounce back to after sign-in. Do not skip this for a split
# frontend/backend setup — it defaults to "/", which resolves against the
# *server's* own origin (this port), not the frontend's.
OIDC_FRONTEND_REDIRECT=http://localhost:3000
# Where the Tauri desktop shell's sign-in flow lands after completing OIDC in
# the system browser (see frontend/src-tauri's deep-link handling). Only
# ever a fixed custom-scheme URL, never a caller-supplied one — see
# crates/server/src/auth.rs's PkceEntry::desktop doc comment for why.
# DESKTOP_REDIRECT_URI=solarplex-desktop://auth

# Shim / sidecar (agent attach) — run via `cargo run -p shim`, not `sidecar`
# directly; shim does the token exchange below, then spawns guardian and
# sidecar as children. Linux/WSL2 only — see README.md's platform note.
SOLARPLEX_WS=ws://localhost:8080
# The one-time token from the UI's "Attach Agent" launch command (or from
# POST /api/sessions/:id/attach-token, which now requires being signed in as
# a Collaborator+ member — see README.md). shim exchanges this for its real
# session ID, actor ID, and capability ID (SOLARPLEX_CAP_ID) at startup, then
# discards it; the exchanged cap ID is the credential used for every
# subsequent agent-facing call (attach/detach/status/heartbeat/approvals).
SOLARPLEX_TOKEN=<one-time-token-from-ui>
# 7777 here is just a single-agent placeholder. The UI's "Attach Agent" flow
# generates a per-agent port (a deterministic hash of the cap id) so multiple
# agents attached around the same time don't collide on the one port your MCP
# client actually connects to — copy the real value (and the matching MCP URL)
# from the launch command shown in the UI, don't hardcode 7777 for real use.
SIDECAR_PORT=7777
UPSTREAM_MCP_URL=http://localhost:3000
FAIL_OPEN=false
# Set to 1 only in development when bwrap is unavailable. MUST NOT be set in production.
# SOLARPLEX_ALLOW_UNSANDBOXED=1
#
# Opt-in assertion for deployments that have actually set up IMA appraisal +
# dm-verity (docs/threat-model.md §4.6) — the guardian refuses to start if
# /sys/kernel/security/ima/policy is absent, catching a deployment that
# forgot to enable it instead of just logging a warning nobody reads.
# The build/delivery tooling for both layers now exists (deploy/scripts/
# build-verity-image.sh, sign-ima-binaries.sh, and the
# solarplex_binary_integrity Ansible role), but activating it on a host is
# still a separate, manual, one-host-at-a-time step
# (`ansible-playbook site.yml --tags enable_ima_appraisal`, then a later
# manual flip from log to enforce mode). Leave this unset until that step
# has actually been run against this specific host.
# SOLARPLEX_REQUIRE_IMA=1
#
# Manually setting SOLARPLEX_SESSION_ID / SOLARPLEX_ACTOR_ID instead of
# SOLARPLEX_TOKEN still starts shim, but skips the token exchange entirely —
# there's no SOLARPLEX_CAP_ID in that case, so agent-attach/status/heartbeat/
# approval calls silently no-op rather than erroring. Not a supported path;
# only ever useful for probing shim's non-network startup behavior.
# SOLARPLEX_SESSION_ID=<session-ulid>
# SOLARPLEX_ACTOR_ID=<agent-ulid>

# Postgres backup (deploy/scripts/backup-postgres.sh) — not consumed by the
# server itself, only by the solarplex-backup systemd timer. On a real
# deployment these are delivered via a second age-encrypted bundle
# (backup-secrets.age, see deploy/ansible/roles/solarplex_backup/), not
# this file; listed here only so the script's required env is discoverable
# and so it can be run by hand for a manual backup/restore test.
# RESTIC_REPOSITORY=s3:s3.<region>.backblazeb2.com/<bucket>
# RESTIC_PASSWORD=<restic repository passphrase>
# AWS_ACCESS_KEY_ID=<Backblaze B2 "S3 compatible" application key ID>
# AWS_SECRET_ACCESS_KEY=<Backblaze B2 "S3 compatible" application key>
# ALERT_WEBHOOK_URL=<optional — posts a one-line alert on backup failure>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# NEXT_PUBLIC_ACTOR_ID is a dev-mode fallback for pre-OIDC local builds only.
# In production, actor identity MUST be derived server-side from sp_token/OIDC.
# Setting this to a static value in production is a critical security misconfiguration.
# NEXT_PUBLIC_ACTOR_ID=<dev-only>
